{
  "manifest_version": 3,
  "name": "ONYX LeadHunter v4.1 \u2014 Complete Maps Leads",
  "version": "4.1",
  "description": "Opens Google Maps results one at a time, waits for complete details including late phone numbers, and saves each lead to ONYX.",
  "permissions": [
    "downloads",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.google.com/search*",
    "https://www.google.com/maps*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
    ,"https://onyx-crm.edgeformmedia.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/maps*"
      ],
      "js": [
        "lists.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "sheets-code.gs"
      ],
      "matches": [
        "https://www.google.com/*"
      ]
    }
  ]
}
